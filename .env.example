# TELEGRAM CONFIG
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# LLM API KEYS
NVIDIA_API_KEY="your-nvidia-nim-api-key"
GROQ_API_KEY="your-groq-api-key"
GEMINI_API_KEY="your-gemini-api-key"

# INFRASTRUCTURE / CLOUDFLARE
CF_GATEWAY_URL="https://gateway.ai.cloudflare.com/v1/your-account/your-gateway"

# PERSISTENCE & MEMORY
FIREBASE_CREDS="/path/to/your/firebase-credentials.json"
UPSTASH_REDIS_URL="redis://default:password@your-upstash-url:6379"

# SECURITY & INTEGRATIONS
API_SECRET="your-shared-webhook-secret"
GITHUB_PAT="your-github-personal-access-token"

# CREDENTIAL VAULT (Fernet 32-byte url-safe base64-encoded key)
VAULT_MASTER_KEY="your-32-byte-base64-fernet-key"
NVIDIA_MODEL_NAME=meta/llama-3.1-70b-instruct
